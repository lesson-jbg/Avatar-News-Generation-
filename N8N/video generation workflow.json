    {
      "parameters": {
        "jsCode": "const url = 'https://api.avatartalk.ai/inference';\nconst headers = {\n  'Authorization': 'Bearer   eDXPUHQeJZvdyz3RQELcH4CIjccPJeaK5DX-Gc-OUGU  ',\n  'Content-Type': 'application/json'\n};\nconst body = {\n  text: $input.first().json.body.news_text,\n  avatar: 'arab_man',\n  emotion: 'neutral',\n  language: 'ar'\n};\n\n// Step 1: Create the video request\nconst response = await this.helpers.request({\n  method: 'POST',\n  url,\n  headers,\n  body,\n  json: true,\n});\n\n// Step 2: Extract the mp4 URL\nconst mp4Url = response.mp4_url;\n\nif (!mp4Url) {\n  return [{ json: { error: 'mp4_url not found', response } }];\n}\n\n// Step 3: Download the video binary\nconst videoData = await this.helpers.request({\n  method: 'GET',\n  url: mp4Url,\n  encoding: null, // to get binary data\n});\n\n// Step 4: Return video as binary so next node can use it\nreturn [\n  {\n    json: {\n      message: 'Video generated successfully',\n      mp4_url: mp4Url,\n    },\n    binary: {\n      video: await this.helpers.prepareBinaryData(videoData, 'video.mp4'),\n    },\n  },\n];\n"
      },
