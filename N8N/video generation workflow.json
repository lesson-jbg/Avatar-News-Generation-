    {
      "parameters": {
        "jsCode": "// n8n Code node - JavaScript\n// Input: item.json.text (contains the labeled Arabic article)\n\nconst item = $input.first().json.content.parts[0]\nconst raw = (item.text ?? \"\").toString();\n\n// Convert literal \"\\n\" to real newlines\nlet s = raw.replace(/\\r/g, \"\");\nif (s.includes(\"\\\\n\")) s = s.replace(/\\\\n/g, \"\\n\");\n\n// Normalize blank lines\ns = s.replace(/\\n{3,}/g, \"\\n\\n\").trim();\n\n// Arabic section labels\nconst labels = [\"التصنيف\", \"العنوان\", \"المقدمة\", \"التفاصيل\", \"الخاتمة\", \"الكلمات_المفتاحية\"];\nconst labelPattern = labels.join(\"|\");\n\n// Helper function to capture each section\nfunction capture(label) {\n  const re = new RegExp(`${label}\\\\s*:\\\\s*([\\\\s\\\\S]*?)(?=\\\\n\\\\n(?:${labelPattern})\\\\s*:|$)`, \"m\");\n  const m = s.match(re);\n  return m ? m[1].trim() : \"\";\n}\n\nconst category   = capture(\"التصنيف\");\nconst title      = capture(\"العنوان\");\nconst intro      = capture(\"المقدمة\");\nconst details    = capture(\"التفاصيل\");\nconst conclusion = capture(\"الخاتمة\");\n\n// Build body paragraphs\nconst paragraphs = [intro, details, conclusion]\n  .map(p => p && p.replace(/\\s+/g, \" \").trim())\n  .filter(Boolean);\n\nconst body = paragraphs.join(\"\\n\\n\");\n\n// Combine title + body for full readable article\nconst news_text = [title, body].filter(Boolean).join(\"\\n\\n\").trim();\n\nlet formated_text={\n    json: {\n      category,\n      title,\n      body,\n      news_text,   // full text for ElevenLabs\n      clean_text: body\n    }\n  }\n// Return a single item with cleaned fields\nreturn formated_text;\n"
      },
